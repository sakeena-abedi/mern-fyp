# Backend Environment Variables
# Copy this file to .env and fill in your actual values

NODE_ENV=development
PORT=5000

# MongoDB Connection String
# For local development: mongodb://localhost:27017/helpdesk
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/helpdesk?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/helpdesk

# JWT Secret (use a strong random string, minimum 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-to-a-random-string

# Frontend URL (for CORS configuration)
CLIENT_URL=http://localhost:5173

# Logging level
LOG_LEVEL=info
